<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Template for third-party plugins. A real plugin references the released
    Callsign.API.dll (HintPath) instead of the project, with Private=false.
    Output goes to <GTA V>\Callsign\Plugins\.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Callsign.API\Callsign.API.csproj" Private="false" />
    <Reference Include="ScriptHookVDotNet3">
      <HintPath>..\..\lib\ScriptHookVDotNet3.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
