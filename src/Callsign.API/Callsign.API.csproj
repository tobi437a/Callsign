<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The PUBLIC plugin API. Third-party plugins reference ONLY this assembly.
    It must never reference Callsign.Core or Callsign (internals stay free to change).
    Treat every public member as a promise: see CLAUDE.md "Plugin API rules".
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Callsign.API</RootNamespace>
    <Version>0.1.0</Version>
    <!-- Not strong-named, so the CLR ignores this when binding; kept fixed anyway. -->
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ScriptHookVDotNet3">
      <HintPath>..\..\lib\ScriptHookVDotNet3.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
